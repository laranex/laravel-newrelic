parameters:
    level: 7
    phpVersion: 80100
    paths:
        - src
        - config
    tmpDir: build/phpstan
    configDirectories:
        - config
    # Typed class constants need PHP 8.3; this package supports PHP 8.1.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: typeCoverage.constantTypeCoverage
        # PHPStan 1.x (Larastan 2, the Laravel 10/11 lanes) cannot match the processors' conditional return type,
        # which keeps them tolerant of Monolog 2 array records, against Monolog's callable(LogRecord): LogRecord.
        - message: '#^Parameter \#1 \$callback of method Monolog\\Logger::pushProcessor\(\) expects callable\(Monolog\\LogRecord\): Monolog\\LogRecord#'
          path: src/Logging/NewRelicLogger.php
